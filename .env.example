TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_WEBAPP_URL=https://bot.example.com/telegram/webapp
OPENROUTER_API_KEY=replace-me
DATABASE_URL=sqlite:///backend/data/app.db
LLM_MODEL=google/gemini-2.5-flash-lite
# Pronunciation (optional). Provider: Yandex SpeechKit if YANDEX_TTS_API_KEY is set, else
# Google Cloud Text-to-Speech if GOOGLE_TTS_API_KEY is set (Yandex wins when both are set).
YANDEX_TTS_API_KEY=
YANDEX_TTS_VOICE=john
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Aoede
# Browser extension (optional): bearer token for POST /api/clip; unset = the endpoint answers 503.
# Generate one with: openssl rand -hex 32
CLIP_TOKEN=
